# ---------------------------------------------------------------------------
# Скопируй в .env:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- PostgreSQL (используется и docker-compose, и backend) ---
POSTGRES_USER=salon
POSTGRES_PASSWORD=salon
POSTGRES_DB=salon
POSTGRES_PORT=5433

# --- Backend ---
# Основная БД. Схема обязательно postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://salon:salon@localhost:5433/salon
# Отдельная БД для pytest. Создаётся автоматически контейнером (init-скрипт).
TEST_DATABASE_URL=postgresql+asyncpg://salon:salon@localhost:5433/salon_test

# Поменяй на длинную случайную строку. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Часовой пояс салона. Все слоты и рабочие часы считаются в нём,
# в БД при этом всё хранится в timestamptz (UTC).
SALON_TZ=Asia/Almaty

# Бизнес-правила
SLOT_STEP_MIN=15          # шаг сетки слотов
MIN_LEAD_TIME_MIN=60      # минимум за сколько минут до начала можно записаться
CANCEL_DEADLINE_MIN=120   # минимум за сколько минут до начала клиент может отменить

# CORS и cookie. На проде: COOKIE_SECURE=true, COOKIE_SAMESITE=none
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:8000
