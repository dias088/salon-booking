# В разработке переменная не нужна: Vite проксирует /api на localhost:8000
# (см. vite.config.ts), поэтому фронтенд и бэкенд выглядят одним origin
# и httpOnly cookie с refresh-токеном работает без настройки SameSite.
#
# На проде указывается адрес API, например:
# VITE_API_URL=https://salon-api.onrender.com
VITE_API_URL=
