# В разработке переменная не нужна: Vite проксирует /api на localhost:8000
# (см. vite.config.ts), поэтому фронтенд и бэкенд выглядят одним origin
# и httpOnly cookie с refresh-токеном работает без настройки SameSite.
#
# На проде указывается адрес API, например:
# VITE_API_URL=https://salon-api.onrender.com
VITE_API_URL=

# ---------------------------------------------------------------------------
# Бренд салона
#
# Всё необязательно: пустые значения заменяются демо-данными из
# src/config/brand.ts. Чтобы поднять проект для другого салона, задайте
# эти переменные при сборке — код и вёрстку менять не нужно.
#
# На Vercel: Settings -> Environment Variables.
# Локально: скопируйте этот файл в frontend/.env.local
# ---------------------------------------------------------------------------

# Название. Последнее слово подсвечивается акцентом в логотипе:
# «Салон красоты», «Студия Локон», «Барбершоп Топор».
VITE_BRAND_NAME=

# Буква в квадрате слева от названия. По умолчанию — первая буква названия.
VITE_BRAND_MONOGRAM=

VITE_BRAND_CITY=

# Часы работы одной строкой, как показывать посетителю.
VITE_BRAND_HOURS=

# Телефон в подвале. Пусто — блок не выводится.
VITE_BRAND_PHONE=

# Приписка в подвале. Для настоящего клиента поставьте пробел,
# чтобы убрать «Учебный проект».
VITE_BRAND_FOOTER_NOTE=
